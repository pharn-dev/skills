{
  "globs": ["**/*.md"],
  "config": {
    "default": true,
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD033": false,
    "MD041": false,
  },
  "ignores": [
    ".git/**",
    // Other Claude Code sessions' worktrees and Codex's import of .claude (.agents/skills, gitignored): never this repo's markdown.
    ".claude/worktrees",
    ".agents/skills",
    // Installed and updated by the PHARN CLI (pharn.records.json); not edited by hand.
    "pharn",
    // Byte copies of pharn-ci's files, pinned by sha256 in the tests.
    "plugins/pharn-ci/tests/fixtures/**",
    "**/node_modules/**",
    "**/.cache/**",
    "**/dist/**",
    "**/evals/results/**",
  ],
}
