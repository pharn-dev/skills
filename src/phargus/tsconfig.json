{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": [
    "runtime/**/*.mjs",
    "runtime/**/*.d.ts",
    "scripts/**/*.mjs",
    "test/**/*.mjs",
    "evals/**/*.mjs",
    "eslint.config.mjs"
  ],
  "exclude": ["node_modules", ".cache", "dist", "evals/results"]
}
